{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Planuvalnyk",
  "version": "0.1.0",
  "identifier": "com.planuvalnyk.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Планувальник",
        "width": 1400,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 650,
        "decorations": false,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
